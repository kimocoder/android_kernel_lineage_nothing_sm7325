# Backports Build Configuration for ath11k_ahb
# Generated from compatibility assessment on Sun Nov 9 2025
#
# This configuration enables backporting of ath11k_ahb driver from kernel 5.15
# to MSM-5.4 kernel for QCA6750 wireless chipset support on SM7325 platforms.

# ============================================================================
# BACKPORTS SYSTEM CONFIGURATION
# ============================================================================

# Enable the backports build system
BACKPORTS_ENABLE=y

# ============================================================================
# ATH11K DRIVER CONFIGURATION
# ============================================================================

# Enable ath11k wireless driver (core module)
BACKPORTS_ATH11K=y

# Enable ath11k AHB bus variant (for integrated wireless chipsets)
BACKPORTS_ATH11K_AHB=y

# Disable ath11k PCI bus variant (not needed for QCA6750 on SM7325)
BACKPORTS_ATH11K_PCI=n

# Enable QCA6750 specific support
BACKPORTS_ATH11K_QCA6750=y

# ============================================================================
# DEPENDENCY CONFIGURATION
# ============================================================================
# Based on compatibility assessment results:
# - QRTR: COMPATIBLE - Use native kernel implementation
# - MHI:  COMPATIBLE - Use native kernel implementation  
# - QMI:  COMPATIBLE - Use native base, backport ath11k-specific helpers

# QRTR (Qualcomm IPC Router)
# Native QRTR is fully compatible with 5.15 API (includes net_id parameter)
BACKPORTS_USE_NATIVE_QRTR=yes

# MHI (Modem Host Interface)
# Native MHI is fully compatible with required controller API
BACKPORTS_USE_NATIVE_MHI=yes

# QMI (Qualcomm MSM Interface)
# Use native QMI base infrastructure, but backport ath11k-specific helpers
BACKPORTS_USE_NATIVE_QMI_BASE=yes
BACKPORTS_QMI_HELPERS=y

# ============================================================================
# BUILD OPTIONS
# ============================================================================

# Module naming strategy to avoid conflicts
# Options: "prefix" (ath11k_bp.ko), "subdir" (backports/ath11k.ko), "none"
BACKPORTS_MODULE_NAMING=none

# Enable debug symbols for development
BACKPORTS_DEBUG=n

# Enable verbose build output
BACKPORTS_VERBOSE=n

# ============================================================================
# FIRMWARE CONFIGURATION
# ============================================================================

# Firmware directory for QCA6750
# Default: /lib/firmware/ath11k/WCN6750/hw1.0/
BACKPORTS_ATH11K_FIRMWARE_PATH=/lib/firmware/ath11k

# ============================================================================
# COMPATIBILITY LAYER
# ============================================================================

# Enable backports compatibility shims for 5.4 -> 5.15 API differences
BACKPORTS_COMPAT_ENABLE=y

# Specific compatibility features
BACKPORTS_COMPAT_KERNEL_5_4=y
BACKPORTS_COMPAT_KERNEL_5_15=y

# ============================================================================
# NOTES
# ============================================================================
#
# Compatibility Assessment Results:
# - All required QRTR APIs present and compatible (5.15 signatures)
# - All required MHI APIs present and compatible
# - All required QMI base APIs present and compatible
# - Only ath11k-specific QMI message definitions need backporting
#
# This configuration minimizes backporting overhead by leveraging native
# kernel implementations where compatible, reducing:
# - Symbol conflicts
# - Module size
# - Maintenance burden
# - Integration complexity
#
# For detailed compatibility analysis, see:
# - backports/COMPATIBILITY_MATRIX.md
# - backports_compat_report.txt
#
