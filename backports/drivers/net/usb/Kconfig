# USB Network drivers configuration
# This will be populated by gentree.py from upstream kernel

menuconfig CPTCFG_USB_NET_DRIVERS
	tristate "USB Network Adapters"
	depends on BACKPORT_LINUX
	depends on USB && NET
	default USB if USB
	help
	  This section contains drivers for USB network adapters.

if CPTCFG_USB_NET_DRIVERS

# USB network drivers will be added here by gentree.py

endif # CPTCFG_USB_NET_DRIVERS
