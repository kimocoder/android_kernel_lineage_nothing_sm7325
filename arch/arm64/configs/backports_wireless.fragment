# Backports Wireless Subsystem Configuration
# This fragment enables cfg80211 and mac80211 from backports (v5.10)
# to provide updated wireless stack on MSM-5.4 kernel

# Disable in-tree wireless to avoid conflicts
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set

# Enable backports wireless configuration API (cfg80211)
CONFIG_CPTCFG_CFG80211=m
CONFIG_CPTCFG_CFG80211_WEXT=y
CONFIG_CPTCFG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CPTCFG_CFG80211_USE_KERNEL_REGDB_KEYS=y
CONFIG_CPTCFG_CFG80211_DEFAULT_PS=y
CONFIG_CPTCFG_CFG80211_DEBUGFS=y
CONFIG_CPTCFG_CFG80211_CRDA_SUPPORT=y

# Enable backports mac80211 wireless stack
CONFIG_CPTCFG_MAC80211=m
CONFIG_CPTCFG_MAC80211_HAS_RC=y
CONFIG_CPTCFG_MAC80211_RC_MINSTREL=y
CONFIG_CPTCFG_MAC80211_RC_DEFAULT_MINSTREL=y
CONFIG_CPTCFG_MAC80211_RC_DEFAULT="minstrel_ht"
CONFIG_CPTCFG_MAC80211_MESH=y
CONFIG_CPTCFG_MAC80211_LEDS=y
CONFIG_CPTCFG_MAC80211_DEBUGFS=y
CONFIG_CPTCFG_MAC80211_MESSAGE_TRACING=y

# Enable mac80211 debugging (optional, can be disabled for production)
CONFIG_CPTCFG_MAC80211_DEBUG_MENU=y
# CONFIG_CPTCFG_MAC80211_NOINLINE is not set
# CONFIG_CPTCFG_MAC80211_VERBOSE_DEBUG is not set
# CONFIG_CPTCFG_MAC80211_MLME_DEBUG is not set
# CONFIG_CPTCFG_MAC80211_STA_DEBUG is not set
# CONFIG_CPTCFG_MAC80211_HT_DEBUG is not set
# CONFIG_CPTCFG_MAC80211_OCB_DEBUG is not set
# CONFIG_CPTCFG_MAC80211_IBSS_DEBUG is not set
# CONFIG_CPTCFG_MAC80211_PS_DEBUG is not set
# CONFIG_CPTCFG_MAC80211_MPL_DEBUG is not set
# CONFIG_CPTCFG_MAC80211_MPATH_DEBUG is not set
# CONFIG_CPTCFG_MAC80211_MHWMP_DEBUG is not set
# CONFIG_CPTCFG_MAC80211_MESH_SYNC_DEBUG is not set
# CONFIG_CPTCFG_MAC80211_MESH_CSA_DEBUG is not set
# CONFIG_CPTCFG_MAC80211_MESH_PS_DEBUG is not set
# CONFIG_CPTCFG_MAC80211_TDLS_DEBUG is not set

# Enable wireless testing driver (optional)
# CONFIG_CPTCFG_MAC80211_HWSIM is not set
